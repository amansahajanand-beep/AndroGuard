# Paste your existing database URL here.
# Postgres:  postgresql+psycopg://user:password@host:5432/dbname
# MySQL:     mysql+pymysql://user:password@host:3306/dbname
# SQLite:    sqlite:///./androguard.db
DATABASE_URL=sqlite:///./androguard.db

# Change this in production: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
