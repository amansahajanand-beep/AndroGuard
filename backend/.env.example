APP_NAME=AndroGuard APK Analyzer
ANALYZER_VERSION=1.0.0
SCHEMA_VERSION=1.0.0
MAX_APK_SIZE_MB=80
ANALYSIS_TIMEOUT_SECONDS=90
MAX_SCREENSHOTS=40
MAX_IMAGE_BYTES=8388608
JOB_TTL_SECONDS=3600
TEMP_ROOT=./tmp
# Exploration screenshots land under: TEMP_ROOT/screenshots/{package}/{job_id}/
# HITL captures: TEMP_ROOT/screenshots/{package}/{job_id}/hitl/
LOG_LEVEL=INFO
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AAPT_PATH=
UVICORN_WORKERS=1
S3_ENDPOINT_URL=https://PROJECT.storage.supabase.co/storage/v1/s3
# Prefer either the S3_* names or AWS_* aliases (same settings fields).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
S3_REGION=ap-south-1
S3_BUCKET=apk-screenshots
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://PROJECT.supabase.co/storage/v1/object/public
# Phase 8 exploration/HITL key root: apps/{app_id}/runs/{run_id}/...
S3_PREFIX=apps
S3_UPLOAD_TIMEOUT_SECONDS=30
S3_UPLOAD_RETRIES=3
S3_VERIFY_UPLOADS=true
S3_CLEANUP_LOCAL_AFTER_UPLOAD=false
DEX_ANALYSIS_ENABLED=true
MAX_CODE_CLASSES=200
MAX_CODE_METHODS=300
MAX_CODE_FINDINGS=200

# --- Async jobs (optional) ---
# Unset REDIS_URL keeps jobs in PostgreSQL when DATABASE_URL is set, else in memory.
REDIS_URL=
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_RETENTION_SECONDS=86400

# --- Dynamic emulator exploration (opt-in; off by default) ---
# Requires Android platform-tools (adb) + the emulator package. Android Studio is NOT required.
EXPLORATION_ENABLED=false

# Tool discovery. Leave ADB_PATH/EMULATOR_PATH blank to auto-detect from PATH or
# ANDROID_SDK_ROOT (<sdk>/platform-tools/adb, <sdk>/emulator/emulator).
ANDROID_SDK_ROOT=
ADB_PATH=adb
EMULATOR_PATH=
# Name from `emulator -list-avds`. Required when more than one AVD exists.
AVD_NAME=
EMULATOR_SERIAL=

# Emulator boot behaviour
EMULATOR_HEADLESS=false
EMULATOR_COLD_BOOT=false
EMULATOR_WIPE_DATA=false
EMULATOR_GPU_MODE=auto
EMULATOR_EXTRA_ARGS=
EMULATOR_STOP_WHEN_DONE=true
EMULATOR_BOOT_TIMEOUT_SECONDS=240
ADB_COMMAND_TIMEOUT_SECONDS=60
APK_INSTALL_TIMEOUT_SECONDS=300
EXPLORATION_TIMEOUT_SECONDS=300
EXPLORATION_MAX_STATES=25
EXPLORATION_MAX_ACTIONS=200
EXPLORATION_ACTION_DELAY_MS=900
EXPLORATION_SCREENSHOT_FORMAT=png
EXPLORATION_S3_PREFIX=exploration
EXPLORATION_KEEP_APK=true
AD_DETECTION_VISION_ENABLED=false
# Phase 3 state detection (no S3 / no AI yet)
EXPLORATION_STATE_SIMILARITY_THRESHOLD=0.92
EXPLORATION_HASH_SIZE=16
EXPLORATION_HASH_CROP_TOP=0.04
EXPLORATION_HASH_CROP_BOTTOM=0.03
# Phase 4 deterministic explorer (unique meaningful states, not blind screenshots)
# TARGET_STATES_PER_PAGE / MAX_STATES_PER_PAGE / MAX_EXPLORATION_DEPTH
EXPLORATION_TARGET_STATES_PER_PAGE=5
EXPLORATION_MAX_STATES_PER_PAGE=10
EXPLORATION_MAX_DEPTH=20
EXPLORATION_STABILIZE_MS=500
EXPLORATION_SPLASH_WAIT_SECONDS=3
EXPLORATION_SPLASH_MAX_WAIT_SECONDS=45
EXPLORATION_SPLASH_MAX_POLLS=15
# Phase 5: unique ad-placement variations (not blind screenshots)
# TARGET_AD_VARIATIONS_PER_PAGE / MAX_AD_VARIATIONS_PER_PAGE / MAX_EXPLORATION_RUNS
EXPLORATION_TARGET_AD_VARIATIONS_PER_PAGE=5
EXPLORATION_MAX_AD_VARIATIONS_PER_PAGE=10
EXPLORATION_MAX_RUNS=5
EXPLORATION_AD_BBOX_QUANTIZE=0.05
# Phase 6: screenshot ad detection (AI analyzes images only — never controls the emulator)
AD_DETECTION_ENABLED=true
AD_DETECTION_PROVIDER=heuristic
AD_DETECTION_MIN_CONFIDENCE=0.45
AD_DETECTION_TIMEOUT_SECONDS=60
# Optional vision backends (set provider=openai|gemini|claude and the matching key)
# OPENAI_API_KEY=
# AD_DETECTION_OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# AD_DETECTION_GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=
# AD_DETECTION_CLAUDE_MODEL=claude-3-5-sonnet-latest
# AD_DETECTION_LOCAL_MODEL_PATH=
# AD_DETECTION_OD_MODEL_PATH=

# --- Phase 7: Human-in-the-Loop (HITL) ---
# When terms/privacy/permissions/system prompts appear, exploration pauses for a human.
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=1800
# Comma-separated system / OEM packages that host decision dialogs.
HITL_SYSTEM_PACKAGES=com.android.settings,com.android.permissioncontroller,com.google.android.permissioncontroller,com.google.android.packageinstaller,com.android.packageinstaller,com.google.android.settings,com.android.systemui,com.android.vpndialogs,com.google.android.gms
HITL_UNKNOWN_BLOCKING_ENABLED=true

# --- Phase 10: AI / LangGraph decision layer (optional) ---
# AI only selects among allow-listed UI actions. Never executes shell/ADB/code.
# Prefer deterministic rules; AI is called only when navigation is ambiguous/stuck.
# NVIDIA OpenAI-compatible API (Nemotron):
AI_EXPLORER_ENABLED=false
AI_EXPLORER_API_KEY=nvapi-your-key-here
AI_EXPLORER_API_BASE=https://integrate.api.nvidia.com/v1
AI_EXPLORER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_EXPLORER_TIMEOUT_SECONDS=60
AI_EXPLORER_MIN_CANDIDATES=3
# NVIDIA often rejects OpenAI response_format=json_object — keep false.
AI_EXPLORER_JSON_RESPONSE_FORMAT=false
