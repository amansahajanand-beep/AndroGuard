APP_NAME=AndroGuard APK Analyzer
ANALYZER_VERSION=1.0.0
SCHEMA_VERSION=1.0.0
MAX_APK_SIZE_MB=80
ANALYSIS_TIMEOUT_SECONDS=90
MAX_SCREENSHOTS=40
MAX_IMAGE_BYTES=8388608
JOB_TTL_SECONDS=3600
TEMP_ROOT=./tmp
LOG_LEVEL=INFO
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AAPT_PATH=
UVICORN_WORKERS=1
S3_ENDPOINT_URL=https://PROJECT.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET=apk-screenshots
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://PROJECT.supabase.co/storage/v1/object/public
DEX_ANALYSIS_ENABLED=true
MAX_CODE_CLASSES=200
MAX_CODE_METHODS=300
MAX_CODE_FINDINGS=200

# --- Async jobs (optional) ---
# Unset REDIS_URL keeps jobs in PostgreSQL when DATABASE_URL is set, else in memory.
REDIS_URL=
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_RETENTION_SECONDS=86400

# --- Dynamic emulator exploration (opt-in; off by default) ---
# Requires Android platform-tools (adb) and a running emulator. Android Studio is NOT required.
EXPLORATION_ENABLED=false
ADB_PATH=adb
EMULATOR_SERIAL=
EMULATOR_BOOT_TIMEOUT_SECONDS=240
EXPLORATION_TIMEOUT_SECONDS=600
EXPLORATION_MAX_STATES=25
EXPLORATION_MAX_ACTIONS=60
EXPLORATION_ACTION_DELAY_MS=900
EXPLORATION_SCREENSHOT_FORMAT=png
EXPLORATION_S3_PREFIX=exploration
EXPLORATION_KEEP_APK=true
AD_DETECTION_VISION_ENABLED=false
